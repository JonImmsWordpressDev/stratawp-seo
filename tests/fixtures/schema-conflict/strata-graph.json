{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://example.test/#organization",
      "name": "Example Co",
      "url": "https://example.test/",
      "logo": { "@type": "ImageObject", "url": "https://example.test/logo.png" },
      "sameAs": ["https://www.linkedin.com/company/example"]
    },
    {
      "@type": "WebSite",
      "@id": "https://example.test/#website",
      "name": "Example Co",
      "url": "https://example.test/",
      "publisher": { "@id": "https://example.test/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://example.test/?s={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Plumber",
      "@id": "https://example.test/#localbusiness",
      "name": "Example Plumbing",
      "url": "https://example.test/",
      "parentOrganization": { "@id": "https://example.test/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "https://example.test/hello-world/#webpage",
      "url": "https://example.test/hello-world/",
      "name": "Hello world - Example Co",
      "isPartOf": { "@id": "https://example.test/#website" }
    },
    {
      "@type": "Person",
      "@id": "https://example.test/#/schema/person/1",
      "name": "Sam Author"
    },
    {
      "@type": "Article",
      "@id": "https://example.test/hello-world/#article",
      "headline": "Hello world",
      "author": { "@id": "https://example.test/#/schema/person/1" },
      "publisher": { "@id": "https://example.test/#organization" },
      "mainEntityOfPage": { "@id": "https://example.test/hello-world/#webpage" },
      "about": { "@id": "https://www.wikidata.org/wiki/Q42" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://example.test/hello-world/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://example.test/" },
        { "@type": "ListItem", "position": 2, "name": "Hello world" }
      ]
    }
  ]
}
